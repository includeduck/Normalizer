<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.dbms.analyzer.javafx.controllers.MainController">
    <top>
        <VBox spacing="10" style="-fx-padding: 10;">
            <Label text="DBMS Normalization &amp; Functional Dependency Analyzer" styleClass="title"/>

            <!-- Row 1: Relation & FD management -->
            <HBox spacing="8">
                <Button text="Create Relation" onAction="#handleCreateRelation"/>
                <Button text="Add FD" onAction="#handleAddFd"/>
                <Button text="Remove FD" onAction="#handleRemoveFd"/>
                <Button text="Clear All" onAction="#handleClearAll"/>
            </HBox>

            <!-- Row 2: Analysis actions -->
            <HBox spacing="8">
                <Button text="Compute Closure" onAction="#handleComputeClosure"/>
                <Button text="Find Candidate Keys" onAction="#handleFindCandidateKeys"/>
                <Button text="Analyze Normal Form" onAction="#handleAnalyzeNormalForm"/>
                <Button text="Minimal Cover" onAction="#handleMinimalCover"/>
            </HBox>

            <!-- Row 3: Decomposition -->
            <HBox spacing="8">
                <Button text="BCNF Decomposition" onAction="#handleBcnfDecomposition"/>
                <Button text="3NF Synthesis" onAction="#handleThreeNfSynthesis"/>
                <Button text="Check Decomposition" onAction="#handleCheckDecomposition"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.3">
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label text="Relation:" styleClass="title"/>
                <Label fx:id="relationLabel" text="No relation defined" wrapText="true"/>
                
                <Label text="Functional Dependencies:" styleClass="title"/>
                <ListView fx:id="fdListView" prefHeight="300"/>
            </VBox>

            <VBox spacing="10" style="-fx-padding: 10;">
                <Label text="Analysis Results:" styleClass="title"/>
                <TextArea fx:id="resultTextArea" wrapText="true" prefHeight="400" editable="false"
                          VBox.vgrow="ALWAYS"/>
            </VBox>
        </SplitPane>
    </center>

    <bottom>
        <VBox style="-fx-padding: 10; -fx-border-color: #CCCCCC; -fx-border-width: 1 0 0 0;">
            <Label text="Status: Ready" fx:id="statusLabel"/>
        </VBox>
    </bottom>

    <stylesheets>
        <String fx:value="@../css/styles.css"/>
    </stylesheets>
</BorderPane>
